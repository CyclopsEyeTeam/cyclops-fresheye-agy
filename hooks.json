{
  "cyclops-fresheye": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/hook.js --event SessionStart",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node scripts/hook.js --event PreInvocation",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook.js --event PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/hook.js --event Stop",
        "timeout": 5
      }
    ]
  }
}
